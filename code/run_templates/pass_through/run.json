{
  "steps": [
    {
      "id": "fetch_parameters",
      "command": "csm-data",
      "arguments": [
        "api",
        "run-load-data"
      ],
      "useSystemEnvironment": true
    },
    {
      "id": "generate_output_data",
      "command": "python",
      "arguments": [
        "code/run_templates/pass_through/generate_csv_files.py"
      ],
      "precedents": [
        "fetch_parameters"
      ],
      "useSystemEnvironment": true
    }
  ]
}